<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>alfie_vr</name>
  <version>0.0.0</version>
  <description>VR (WebXR) teleoperation for the Alfie robot</description>
  <maintainer email="alansrobotlab@todo.todo">alansrobotlab</maintainer>
  <license>TODO: License declaration</license>

  <depend>rclpy</depend>
  <depend>alfie_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rcl_interfaces</depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>alfie_urdf</exec_depend>
  <exec_depend>python3-websockets</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
