[Unit]
Description=Alfie QMD vault-search daemon (lloyd's qmd fork, CPU on Orin)
After=network.target

[Service]
Type=simple
User=alfie
Group=alfie
EnvironmentFile=/home/alfie/alfiebot_ws/src/alfie_agent/qmd/qmd.env
WorkingDirectory=/home/alfie
# Run the fork's CLI directly under Node 24 to avoid shebang/PATH ambiguity.
# Built from github.com/alansrobotlab2/qmd (branch lloyd) into ~/qmd; see README.md.
ExecStart=/home/alfie/.local/node/bin/node /home/alfie/qmd/bin/qmd mcp --http --port 8181
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
