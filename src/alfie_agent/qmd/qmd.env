# Environment for the QMD vault-search daemon + watcher (systemd EnvironmentFile).
# Absolute values only (systemd does not expand $HOME or run a shell here).
#
# QMD is lloyd's fork (github.com/alansrobotlab2/qmd, branch lloyd), built into
# ~/qmd under Node 24 (~/.local/node) with node-llama-cpp's prebuilt linux-arm64
# CPU binary. Models are cached under ~/.cache/qmd/models after the first run.
HOME=/home/alfie
PATH=/home/alfie/.local/node/bin:/usr/bin:/bin
QMD_BIN=/home/alfie/qmd/bin/qmd
# CPU only: the 35B MLC model owns the Orin GPU. With the fork's in-memory vector
# index a warm hybrid (lex+vec) query is ~35 ms and lex-only ~5 ms on CPU; the
# first query after start pays ~4 s for the embedding-model load (agent_node
# warms it at startup).
QMD_LLAMA_GPU=false
QMD_FORCE_CPU=1
# Loopback only (the agent is the sole client).
QMD_HOST=127.0.0.1
# Binary-quantized vectors (smaller/faster), matching lloyd's deployment.
QMD_VEC_BACKEND=bit
