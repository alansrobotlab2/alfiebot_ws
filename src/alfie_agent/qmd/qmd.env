# Environment for the QMD vault-search daemon + watcher (systemd EnvironmentFile).
# Absolute values only (systemd does not expand $HOME or run a shell here).
#
# QMD (tobi/qmd, npm @tobilu/qmd) runs under Node 24 + Bun with node-llama-cpp.
# All models are pre-cached under ~/.cache/qmd/models so nothing is downloaded at
# start (fully offline).
HOME=/home/alfie
PATH=/usr/local/cuda/bin:/home/alfie/.local/node/bin:/home/alfie/.bun/bin:/usr/bin:/bin
CUDA_HOME=/usr/local/cuda
CUDA_PATH=/usr/local/cuda
# GPU. node-llama-cpp's llama.cpp is patched to force ggml's legacy (cudaMalloc)
# CUDA pool instead of the VMM pool -- the VMM pool reserves a fixed 32 GB of GPU
# virtual address space (cuMemAddressReserve) which fails once the 35B MLC model
# is resident. The leg pool does no VA reservation, so qmd coexists with MLC on
# the Orin GPU. (Patch: ggml-cuda.cu new_pool_for_device -> forced leg pool.)
# CPU embedding was ~18 s/query (only ~4 threads); GPU brings vec+lex under 200 ms.
QMD_LLAMA_GPU=false
QMD_FORCE_CPU=1
# Binary-quantized vectors (smaller/faster), matching lloyd's deployment.
QMD_VEC_BACKEND=bit
