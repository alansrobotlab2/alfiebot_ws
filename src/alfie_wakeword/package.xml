<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>alfie_wakeword</name>
  <version>0.0.0</version>
  <description>openWakeWord wake-word detection: opens the conversation window and barges in on TTS.</description>
  <maintainer email="alansrobotlab@gmail.com">alfie</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>alfie_msgs</exec_depend>
  <!-- pip: openwakeword, numpy, onnxruntime (installed via pip, not rosdep) -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
