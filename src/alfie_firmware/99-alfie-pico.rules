# Alfie Pico stable serial-device naming
#
# The Alfie picos are RP2040-based boards from Raspberry Pi (USB vendor 2e8a),
# but the exact model/product ID varies (e.g. Waveshare RP2040 Zero = 2e8a:0003,
# Raspberry Pi Pico = 2e8a:000a). The kernel ttyACM* index is NOT stable across
# boots, so each device is matched by its globally-unique USB serial alone
# (vendor 2e8a is included only as a cheap pre-filter). The original /dev/ttyACM*
# node still exists; these rules only add named aliases.
#
# Install:  sudo cp 99-alfie-pico.rules /etc/udev/rules.d/
#           sudo udevadm control --reload-rules && sudo udevadm trigger
# Verify:   ls -l /dev/ttyAlfie*

# picotool / raw-USB access. The tty rules above are not enough: picotool talks
# to the board over libusb (/dev/bus/usb/...), and in BOOTSEL mode the board has
# no tty at all. Without this, uploads fail with "appears to be in BOOTSEL mode,
# but picotool was unable to connect. Maybe try 'sudo'".
SUBSYSTEM=="usb", ATTRS{idVendor}=="2e8a", MODE="0666", TAG+="uaccess"

# Heartbeat pico -> /dev/ttyAlfieH  (Waveshare RP2040 Zero, serial 530328473106349C)
SUBSYSTEM=="tty", ATTRS{idVendor}=="2e8a", ATTRS{serial}=="530328473106349C", SYMLINK+="ttyAlfieH", GROUP="dialout", MODE="0666"

# Back driver -> /dev/ttyAlfieB  (Waveshare RP2040 Zero, serial 5303284740EC7D9C)
# Board replaced during the gen2 rebuild. The previous one was a Raspberry Pi
# Pico, serial 5044340578353C1C - kept here only so an old board turning up in a
# drawer can be identified. Note the replacement is an RP2040 Zero, which is what
# the firmware already assumes (WS2812B_PIN 16 is its onboard addressable LED).
SUBSYSTEM=="tty", ATTRS{idVendor}=="2e8a", ATTRS{serial}=="5303284740EC7D9C", SYMLINK+="ttyAlfieB", GROUP="dialout", MODE="0666"

# ttyAlfieL pico -> /dev/ttyAlfieL  (serial 5303284738D1359C)
SUBSYSTEM=="tty", ATTRS{idVendor}=="2e8a", ATTRS{serial}=="5303284738D1359C", SYMLINK+="ttyAlfieL", GROUP="dialout", MODE="0666"

# ttyAlfieR pico -> /dev/ttyAlfieR  (serial 530328474102739C)
SUBSYSTEM=="tty", ATTRS{idVendor}=="2e8a", ATTRS{serial}=="530328474102739C", SYMLINK+="ttyAlfieR", GROUP="dialout", MODE="0666"

# ttyAlfieD pico -> /dev/ttyAlfieD  (serial 5303284740F45C9C)
SUBSYSTEM=="tty", ATTRS{idVendor}=="2e8a", ATTRS{serial}=="5303284740F45C9C", SYMLINK+="ttyAlfieD", GROUP="dialout", MODE="0666"
#SUBSYSTEM=="tty", ATTRS{idVendor}=="2e8a", ATTRS{serial}=="<SERIAL>", SYMLINK+="ttyAlfie<X>", GROUP="dialout", MODE="0666"
